	(gr_text "Rules:"
		(at 245 103.6 0)
		(layer "Cmts.User")
		(uuid "24c408b9-78dd-4eed-bb83-9a5db334cc61")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "  1. No 5 V on any GPIO or on 3V3. Common GND only."
		(at 245 106.8 0)
		(layer "Cmts.User")
		(uuid "e0430b9a-e518-4437-b61e-19b97cab207d")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "  2. 3V3 comes from the DevKit LDO. Do not back-feed."
		(at 245 110 0)
		(layer "Cmts.User")
		(uuid "054b59db-9d12-491a-99ab-4d71e9ced8c2")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "  3. JP1 (5V -> VIN) OPEN on the bench. USB powers U1."
		(at 245 113.2 0)
		(layer "Cmts.User")
		(uuid "06f11240-b1b8-4dda-a0f4-f1dd78d2415a")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "  4. JP_BEEP/JP_PIR: 5 V position only for 5 V modules."
		(at 245 116.4 0)
		(layer "Cmts.User")
		(uuid "e02bd4b3-4921-461d-859c-58490f7c588c")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "  5. No mains on this board."
		(at 245 119.6 0)
		(layer "Cmts.User")
		(uuid "a62f40a2-157c-414e-9ad9-fb0ad7a9ec92")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "U1 pin order is PROVISIONAL until the DevKit is"
		(at 245 126 0)
		(layer "Cmts.User")
		(uuid "51342d64-6d42-407c-80ef-5b069a0f1643")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left)
