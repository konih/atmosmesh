    (effects (font (size 1.5 1.5)))
    (uuid b299ce7b-28f8-562e-a7ee-b9c62e7c3317)
  )
  (text "NEVER WIRE: GPIO23/18/15/2/4/32 drive the 1.14in TFT; GPIO12 is the flash strap; GPIO1/3 are the USB-UART."
