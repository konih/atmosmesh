    (effects (font (size 1.5 1.5)))
    (uuid e4965f2e-9bc4-507b-80f0-8d6a6338d808)
  )
  (text "No Zener clamps: known inventory starts at 5.1V and is unsuitable for 3.3V GPIO protection."
