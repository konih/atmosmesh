#!/usr/bin/env python3
"""Generate firmware/include/atmosmesh/secrets.hpp from the environment / .envrc.

Preferred operator flow: put WIFI_SSID and WIFI_PASSWORD (and MQTT_*) in a
gitignored .envrc at the main checkout root, `direnv allow`, then `task build`.

This script also loads that .envrc when building from a git worktree, where
direnv may not see the main-checkout file.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path


REQUIRED_WIFI = ("WIFI_SSID", "WIFI_PASSWORD")
REQUIRED_MQTT = ("MQTT_HOST", "MQTT_PASSWORD")
OPTIONAL_DEFAULTS = {
    "MQTT_PORT": "1883",
    "MQTT_USER": "homeassistant",
}


def repo_roots(script: Path) -> list[Path]:
    roots: list[Path] = []
    here = script.resolve().parent.parent  # repo root of this checkout/worktree
    roots.append(here)
    try:
        common = subprocess.check_output(
            ["git", "rev-parse", "--git-common-dir"],
            cwd=here,
            text=True,
        ).strip()
        main_root = Path(common).resolve().parent
        if main_root not in roots:
            roots.append(main_root)
    except (OSError, subprocess.CalledProcessError):
        pass
    return roots


def parse_envrc(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    export_re = re.compile(
        r"""^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(?:'([^']*)'|"([^"]*)"|(\S+))\s*$"""
    )
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        match = export_re.match(stripped)
        if not match:
            continue
        key = match.group(1)
        val = match.group(2) if match.group(2) is not None else (
            match.group(3) if match.group(3) is not None else match.group(4)
        )
        values[key] = val
    return values


def load_values(roots: list[Path]) -> dict[str, str]:
    values: dict[str, str] = {}
    # Later roots (main checkout) first, then worktree .envrc overrides, then process env.
    for root in reversed(roots):
        envrc = root / ".envrc"
        if envrc.is_file():
            values.update(parse_envrc(envrc))
    for key in list(OPTIONAL_DEFAULTS) + list(REQUIRED_WIFI) + list(REQUIRED_MQTT):
        if key in os.environ and os.environ[key] != "":
            values[key] = os.environ[key]
    for key, default in OPTIONAL_DEFAULTS.items():
        values.setdefault(key, default)
    return values


def c_string(value: str) -> str:
    escaped = (
        value.replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", "\\n")
        .replace("\r", "\\r")
    )
    return f'"{escaped}"'


def write_secrets(path: Path, values: dict[str, str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    body = f"""#pragma once

// Generated by scripts/gen-secrets-from-env — do not commit.
// Source: .envrc and/or process environment.

#define ATMOSMESH_WIFI_SSID {c_string(values["WIFI_SSID"])}
#define ATMOSMESH_WIFI_PASSWORD {c_string(values["WIFI_PASSWORD"])}

#define ATMOSMESH_MQTT_HOST {c_string(values["MQTT_HOST"])}
#define ATMOSMESH_MQTT_PORT {int(values["MQTT_PORT"])}
#define ATMOSMESH_MQTT_USER {c_string(values["MQTT_USER"])}
#define ATMOSMESH_MQTT_PASSWORD {c_string(values["MQTT_PASSWORD"])}
"""
    path.write_text(body, encoding="utf-8")


def main() -> int:
    script = Path(__file__)
    roots = repo_roots(script)
    out = roots[0] / "firmware" / "include" / "atmosmesh" / "secrets.hpp"
    values = load_values(roots)

    missing_wifi = [k for k in REQUIRED_WIFI if not values.get(k)]
    if missing_wifi:
        print(
            "gen-secrets-from-env: no Wi-Fi credentials "
            f"(missing {', '.join(missing_wifi)}). "
            "Leaving secrets.hpp absent — sensors/OLED-only build.",
            file=sys.stderr,
        )
        if out.exists():
            # Do not delete an operator-maintained secrets.hpp if env is incomplete.
            print(f"gen-secrets-from-env: keeping existing {out}", file=sys.stderr)
        return 0

    missing_mqtt = [k for k in REQUIRED_MQTT if not values.get(k)]
    if missing_mqtt:
        print(
            "gen-secrets-from-env: Wi-Fi present but MQTT incomplete "
            f"(missing {', '.join(missing_mqtt)}). "
            "Add MQTT_HOST and MQTT_PASSWORD to .envrc (see .envrc.example). "
            "Building without networking until then.",
            file=sys.stderr,
        )
        return 0

    write_secrets(out, values)
    print(f"gen-secrets-from-env: wrote {out} (ssid set, mqtt host={values['MQTT_HOST']})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
