#pragma once

// Hand-maintained alternative to .envrc. Prefer `.envrc` + `task build-all`
// (scripts/gen-secrets-from-env writes this file for you).
// Without credentials the firmware still samples sensors and drives the OLED;
// Wi-Fi and MQTT stay off.
//
// MQTT password: from the kumulus repo —
//   sops -d secrets/mosquitto-operator.yaml
// Look for mqttPassword. Username is homeassistant. Port is 1883 (plain MQTT).

#define ATMOSMESH_WIFI_SSID "your-ssid"
#define ATMOSMESH_WIFI_PASSWORD "your-wifi-password"

#define ATMOSMESH_MQTT_HOST "kum3-lan-address"
#define ATMOSMESH_MQTT_PORT 1883
#define ATMOSMESH_MQTT_USER "homeassistant"
#define ATMOSMESH_MQTT_PASSWORD "your-mqtt-password"
